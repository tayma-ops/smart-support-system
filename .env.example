# Generate your own key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# PostgreSQL is the default. Set USE_SQLITE=True ONLY for a local quick start.
USE_SQLITE=False
DB_NAME=supportdesk
DB_USER=supportdesk
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
CELERY_BROKER_URL=redis://localhost:6379/0
# Optional shared cache for multi-worker auth rate limits. Compose configures Redis.
CACHE_URL=
# True runs tasks synchronously; local development only.
CELERY_TASK_ALWAYS_EAGER=False
# Optional queue isolation; normally leave the default unchanged.
CELERY_TASK_DEFAULT_QUEUE=celery
AI_PROVIDER=ai_service.providers.OpenAIProvider
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
# Optional free local inference with llama.cpp (loopback only):
# AI_PROVIDER=ai_service.providers.LocalModelProvider
# AI_BASE_URL=http://127.0.0.1:8081/v1
# AI_MODEL=Qwen3-0.6B-Q4_K_M
EMAIL_NOTIFICATIONS=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=support@example.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
